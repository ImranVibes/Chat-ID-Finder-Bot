{
  "name": "chat-id-finder-bot",
  "version": "1.0.0",
  "description": "A high-performance and beautiful Telegram Bot to find chat, user, channel, and bot IDs.",
  "main": "dist/bot.js",
  "type": "module",
  "scripts": {
    "deploy": "tgcloud push",
    "migrate": "tgcloud migrate",
    "status": "tgcloud status",
    "login": "tgcloud login",
    "diff": "tgcloud diff",
    "webhook": "tgcloud webhook",
    "run": "tgcloud run",
    "dev:standalone": "tsx watch src/bot.ts",
    "build:standalone": "tsc",
    "start:standalone": "node dist/bot.js"
  },
  "keywords": [
    "telegram",
    "bot",
    "grammy",
    "chat-id",
    "typescript"
  ],
  "author": "Antigravity & Pair-Partner",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "grammy": "^1.23.0"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
